cabal-version:      3.0
name:               crystal-parser
version:            0.1.0.0
author:             Lautaro Bagnasco Muguillo
maintainer:         tatibagnasco@gmail.com
build-type:         Simple

common warnings
  ghc-options: -Wall -Wmissing-import-lists

library
  import: warnings
  exposed-modules:
    Parser
    AstTypes
    TypeResolver
    PPrint
    Rearranger
    Command.Parse
    Command.Rearrange
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:
      base               ^>=4.20.2.0
    , megaparsec         ^>=9.7
    , parser-combinators ^>=1.3
    , text               ^>=2.1.4
    , hspec              ^>=2.11.17
    , hspec-megaparsec   ^>=2.2.1
    , string-interpolate ^>=0.3.4
    , directory          ^>=1.3.10
    , process            ^>=1.6.28
    , filepath           ^>=1.5.5

executable crystal-parser
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Parser
    AstTypes
    TypeResolver
    PPrint
    Rearranger
    Command.Parse
    Command.Rearrange
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:
      base               ^>=4.20.2.0
    , crystal-parser
    , megaparsec         ^>=9.7
    , text               ^>=2.1.4
    , string-interpolate ^>=0.3.4
    , directory          ^>=1.3.10
    , process            ^>=1.6.28
    , filepath           ^>=1.5.5

test-suite crystal-parser-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test, src
  default-language: Haskell2010
  other-modules:
    Parser
    PPrint
    Rearranger
  build-depends:
      base               ^>=4.20.2.0
    , megaparsec         ^>=9.7
    , text               ^>=2.1.4
    , hspec              ^>=2.11.17
    , hspec-megaparsec   ^>=2.2.1
    , string-interpolate ^>=0.3.4
